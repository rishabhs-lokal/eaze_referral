# The 500-coin build — pairs with eaze-referral-service's docker-compose.tier-500.yml.
# There is no default/un-tiered build; copy this file (or .env.tier-1000.example) to .env.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8092
EXPO_PUBLIC_REWARD_COINS=500

# Download link pasted into the invite message. A OneLink, so one URL resolves to the right
# store per device. Same for every referrer — the reward is attributed by phone number, never
# by the link.
EXPO_PUBLIC_DOWNLOAD_URL=https://eaze.onelink.me/x8qY/eirps9xf
