# For running the app directly on the host (outside Docker Compose), against the Postgres
# started by `docker compose -f docker-compose.tier-1000.yml up -d db` (host port 5533).
# There is no default/un-tiered .env.example — copy this one, or .env.tier-500.example, to .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5533/eaze
DATABASE_SSL_MODE=disable
DB_TIMEZONE=Asia/Kolkata
SIGNUP_BONUS_COINS=1000
RECHARGE_BONUS_COINS=1000
PUBLIC_BASE_URL=http://localhost:8091
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.eaze.app
APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
FALLBACK_URL=https://play.google.com/store/apps/details?id=com.eaze.app
LOG_LEVEL=info

# Optional — mirrors accepted referrals into a Google Sheet. Leave both unset to disable
# entirely. See google-apps-script/referral_sheet_webhook.gs for the script + deployment steps.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=some-random-string-matching-the-script's-WEBHOOK_SECRET-property

# Optional — payment verification against Eaze's real warehouse data via Redash. Leave unset to
# disable: the reward pipeline then runs on the recharge webhook alone, exactly as before. With
# these set, a referrer's coins are additionally confirmed against real payment data before
# being credited, and POST /api/referral/admin/reconcile catches any payment the webhook missed.
# See the "Payment verification via Redash" section of README.md for the two queries to create.
# REDASH_BASE_URL=https://redash.yourcompany.com
# REDASH_API_KEY=your-redash-query-or-user-api-key
# REDASH_VERIFY_PHONE_QUERY_ID=17538
# REDASH_PAYMENTS_QUERY_ID=17564

# How often the service re-checks who has paid and credits them, in seconds. This is what makes
# payouts happen on their own — nothing else triggers them. 0 disables the loop and you drive
# POST /api/referral/admin/reconcile yourself.
RECONCILE_INTERVAL_SECONDS=900

# Eaze coin credit API — the thing that actually puts coins in a wallet. Unset means the
# pipeline still decides who is owed what, but no coins leave this service.
# EAZE_FREE_COINS_API_URL=https://api.eazeapp.com/payments/free-coins/upload/
# EAZE_FREE_COINS_AUTH_KEY=your-key
# EAZE_FREE_COINS_AUTH_HEADER=x-n8n-auth-key
